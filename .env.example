# Copy this file to .env and fill in your key, or set the variable in your
# MCP client's config instead (see the README for the Claude Desktop block).
#
# Real environment variables always win over anything in .env.

# YouTube Data API v3 key, from https://console.cloud.google.com/apis/credentials
# Only the two statistics tools need this. Transcripts work without a key.
YOUTUBE_API_KEY=

# Optional. Where the daily quota counter is stored.
# Defaults to ~/.rozetta/quota.json
# ROZETTA_QUOTA_FILE=
